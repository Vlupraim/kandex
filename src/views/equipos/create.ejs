<div class="topbar">
  <a href="/equipos" class="topbar__action" title="Volver"><i data-lucide="arrow-left"></i></a>
  <h1>Nuevo equipo</h1>
</div>

<div class="page-content">
  <div class="form-page">
    <form action="/equipos/create" method="POST">
      <div class="form-section">
        <div class="field">
          <label class="field__label">Nombre del equipo *</label>
          <input class="input input--lg" type="text" name="nombre_equipo" placeholder="Ej. Equipo Frontend" required autofocus>
        </div>
        <div class="field">
          <label class="field__label">Descripción</label>
          <textarea class="input textarea" name="descripcion" rows="3" placeholder="¿En qué trabaja este equipo?"></textarea>
        </div>
      </div>
      <div class="form-actions">
        <a href="/equipos" class="btn btn--ghost">Cancelar</a>
        <button class="btn" type="submit">Crear equipo</button>
      </div>
    </form>
  </div>
</div>

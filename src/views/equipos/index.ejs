<div class="page-header">
  <div>
    <h1 class="page-title">Equipos</h1>
    <p class="page-subtitle">Gestiona los equipos de trabajo</p>
  </div>
  <a href="/equipos/create" class="btn-primary-action"><i class="bi bi-plus-lg"></i> Nuevo Equipo</a>
</div>

<% if (equipos.length === 0) { %>
  <div class="empty-state">
    <i class="bi bi-people"></i>
    <h3>Sin equipos todavía</h3>
    <p>Creá tu primer equipo para empezar a colaborar.</p>
    <a href="/equipos/create" class="btn-primary-action">Crear equipo</a>
  </div>
<% } else { %>
  <div class="cards-grid">
    <% equipos.forEach(equipo => { %>
      <div class="info-card">
        <div class="info-card-icon"><i class="bi bi-people-fill"></i></div>
        <div class="info-card-body">
          <h3 class="info-card-title"><%= equipo.nombre_equipo %></h3>
          <p class="info-card-desc"><%= equipo.descripcion || 'Sin descripción' %></p>
        </div>
        <div class="info-card-actions">
          <a href="/equipos/<%= equipo.id %>" class="task-btn"><i class="bi bi-eye"></i></a>
          <a href="/equipos/delete/<%= equipo.id %>" class="task-btn task-btn-danger"><i class="bi bi-trash"></i></a>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<div class="topbar">
  <h1>Reportes</h1>
</div>

<div class="page-content">
  <div class="stats-row">
    <div class="stat-box">
      <div class="stat-box__label"><span class="stat-box__dot" style="background:var(--green)"></span>Completadas</div>
      <div class="stat-box__value"><%= completadas.length %></div>
    </div>
    <div class="stat-box">
      <div class="stat-box__label"><i data-lucide="clock" style="width:11px;height:11px;margin-right:4px"></i>Tiempo promedio</div>
      <div class="stat-box__value"><%= tiempoPromedio %><span style="font-size:16px;font-weight:400;color:var(--fg-muted)"> h</span></div>
    </div>
    <div class="stat-box">
      <div class="stat-box__label">Total tareas</div>
      <div class="stat-box__value"><%= tareas.length %></div>
    </div>
  </div>

  <div class="form-section" style="margin-bottom:16px">
    <p style="margin:0 0 14px;font-size:13px;font-weight:600">Filtrar por fechas</p>
    <form id="filtroForm">
      <div class="form-row">
        <div class="field">
          <label class="field__label">Fecha inicio</label>
          <input class="input" type="date" id="fecha_inicio">
        </div>
        <div class="field">
          <label class="field__label">Fecha fin</label>
          <input class="input" type="date" id="fecha_fin">
        </div>
        <div class="field" style="align-self:flex-end">
          <button class="btn btn--ghost" type="submit">Filtrar</button>
        </div>
      </div>
    </form>
  </div>

  <div class="form-section">
    <p style="margin:0 0 14px;font-size:13px;font-weight:600">Tareas completadas</p>
    <% if (completadas.length === 0) { %>
      <div class="empty" style="padding:24px">
        <i data-lucide="check-circle"></i>
        <h3>Sin tareas completadas</h3>
      </div>
    <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Título</th>
            <th>Creación</th>
            <th>Finalización</th>
            <th>Duración</th>
          </tr>
        </thead>
        <tbody>
          <% completadas.forEach(t => {
            const inicio = new Date(t.fecha_creacion);
            const fin    = new Date(t.fecha_finalizacion);
            const horas  = ((fin - inicio) / (1000*60*60)).toFixed(1);
          %>
            <tr>
              <td style="font-weight:500"><%= t.titulo %></td>
              <td style="color:var(--fg-muted);font-size:12px"><%= inicio.toLocaleDateString('es-ES') %></td>
              <td style="color:var(--fg-muted);font-size:12px"><%= fin.toLocaleDateString('es-ES') %></td>
              <td><span class="tag tag--green"><%= horas %> h</span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script>
document.getElementById('filtroForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const inicio = document.getElementById('fecha_inicio').value;
  const fin    = document.getElementById('fecha_fin').value;
  if (!inicio || !fin) return;
  const r    = await fetch(`/reportes/filtrar?fecha_inicio=${inicio}&fecha_fin=${fin}`);
  const data = await r.json();
  alert(`${data.total} tareas completadas en ese rango`);
});
</script>

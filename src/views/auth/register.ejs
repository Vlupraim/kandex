<div class="login__brand">
  <div class="login__brand-mark">K</div>
  <span>Kandex</span>
</div>

<div class="login__form-wrap">
  <div class="login__eyebrow">Crea tu cuenta</div>
  <h1>Empieza a organizar</h1>
  <p class="login__sub">Sin tarjeta. Cancela cuando quieras.</p>

  <form action="/auth/register" method="POST">
    <div class="field">
      <label class="field__label">Nombre de usuario</label>
      <input class="input input--lg" type="text" name="nombre_usuario" placeholder="tu_nombre" required>
    </div>
    <div class="field">
      <label class="field__label">Correo electrónico</label>
      <input class="input input--lg" type="email" name="email" placeholder="tu@email.com" required>
    </div>
    <div class="field">
      <label class="field__label">Contraseña</label>
      <input class="input input--lg" type="password" name="password" placeholder="••••••••" required>
    </div>
    <input type="hidden" name="rol" value="usuario">
    <button class="btn btn--block btn--lg" type="submit" style="margin-top:8px">
      Crear cuenta
    </button>
  </form>

  <p class="login__sub" style="margin-top:20px;margin-bottom:0;font-size:13px">
    ¿Ya tienes cuenta? <a href="/auth/login" style="color:var(--fg);font-weight:500">Inicia sesión</a>
  </p>
</div>

<div class="login__foot">
  <span>© 2026 Kandex</span>
  <div class="login__foot-links">
    <a href="#">Privacidad</a>
    <a href="#">Términos</a>
  </div>
</div>

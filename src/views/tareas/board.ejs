<div class="topbar">
  <h1>Tablero</h1>
  <div class="topbar__spacer"></div>
  <a href="/tareas/create" class="topbar__btn">
    <i data-lucide="plus"></i> Nueva tarea
  </a>
</div>

<div class="board-scroll">
  <div class="board">
    <%
      const cols = [
        { id: 'por-realizar', label: 'Por realizar', estado: 'Por realizar',  color: '#9a9286' },
        { id: 'en-progreso',  label: 'En progreso',  estado: 'En progreso',   color: '#d97757' },
        { id: 'en-revision',  label: 'En revisión',  estado: 'En revisión',   color: '#3a6e9c' },
        { id: 'realizado',    label: 'Realizado',     estado: 'Realizado',     color: '#3b6e4f' },
      ];
      cols.forEach(col => {
        const cards = tareas.filter(t => t.estado === col.estado);
    %>
    <div class="col" data-estado="<%= col.estado %>" id="<%= col.id %>">
      <div class="col__head">
        <span class="col__dot" style="background:<%= col.color %>"></span>
        <span class="col__name"><%= col.label %></span>
        <span class="col__count"><%= cards.length %></span>
      </div>
      <div class="col__list">
        <% cards.forEach(t => { %>
          <div class="card" draggable="true" data-id="<%= t.id %>">
            <div class="card__tags">
              <span class="tag priority-<%= t.prioridad %>"><span class="tag-dot"></span><%= t.prioridad %></span>
            </div>
            <div class="card__title"><%= t.titulo %></div>
            <% if (t.descripcion) { %>
              <div class="card__desc"><%= t.descripcion %></div>
            <% } %>
            <div class="card__foot">
              <div class="card__meta">
                <% if (t.fecha_limite) {
                  const hoy = new Date();
                  const lim = new Date(t.fecha_limite);
                  const diff = Math.ceil((lim - hoy) / (1000*60*60*24));
                  const cls = diff < 0 ? 'due--late' : diff <= 2 ? 'due--soon' : '';
                %>
                  <span class="due <%= cls %>">
                    <i data-lucide="calendar" style="width:11px;height:11px"></i>
                    <%= lim.toLocaleDateString('es-ES',{day:'numeric',month:'short'}) %>
                  </span>
                <% } %>
              </div>
              <div class="card__actions">
                <a href="/tareas/edit/<%= t.id %>" class="card__action" title="Editar">
                  <i data-lucide="pencil"></i>
                </a>
                <a href="/tareas/delete/<%= t.id %>" class="card__action card__action--danger" title="Eliminar">
                  <i data-lucide="trash-2"></i>
                </a>
              </div>
            </div>
          </div>
        <% }); %>
        <% if (cards.length === 0) { %>
          <div class="col__empty">Sin tareas en esta columna</div>
        <% } %>
      </div>
      <a href="/tareas/create" class="col__add-card">
        <i data-lucide="plus"></i> Añadir tarea
      </a>
    </div>
    <% }); %>
  </div>
</div>

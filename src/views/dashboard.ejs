<div class="topbar">
  <h1>Resumen</h1>
  <div class="topbar__spacer"></div>
  <a href="/tareas/create" class="topbar__btn">
    <i data-lucide="plus"></i> Nueva tarea
  </a>
</div>

<div class="page-content">
  <div class="stats-row">
    <div class="stat-box">
      <div class="stat-box__label"><span class="stat-box__dot" style="background:#9a9286"></span>Por realizar</div>
      <div class="stat-box__value"><%= tareas.filter(t => t.estado === 'Por realizar').length %></div>
    </div>
    <div class="stat-box">
      <div class="stat-box__label"><span class="stat-box__dot" style="background:var(--accent)"></span>En progreso</div>
      <div class="stat-box__value"><%= tareas.filter(t => t.estado === 'En progreso').length %></div>
    </div>
    <div class="stat-box">
      <div class="stat-box__label"><span class="stat-box__dot" style="background:var(--tag-blue)"></span>En revisión</div>
      <div class="stat-box__value"><%= tareas.filter(t => t.estado === 'En revisión').length %></div>
    </div>
    <div class="stat-box">
      <div class="stat-box__label"><span class="stat-box__dot" style="background:var(--green)"></span>Realizadas</div>
      <div class="stat-box__value"><%= tareas.filter(t => t.estado === 'Realizado').length %></div>
    </div>
  </div>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <p style="margin:0;font-size:13px;font-weight:600">Tareas recientes</p>
    <a href="/tareas" style="font-size:12px;color:var(--fg-muted);text-decoration:none">Ver tablero →</a>
  </div>

  <% if (tareas.length === 0) { %>
    <div class="empty">
      <i data-lucide="inbox"></i>
      <h3>Sin tareas todavía</h3>
      <p>Creá tu primera tarea para empezar.</p>
      <a href="/tareas/create" class="btn btn--sm">Nueva tarea</a>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Estado</th>
          <th>Prioridad</th>
          <th>Fecha límite</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% tareas.slice(0,10).forEach(t => { %>
          <tr>
            <td style="font-weight:500"><%= t.titulo %></td>
            <td><span class="tag"><span class="tag-dot"></span><%= t.estado %></span></td>
            <td><span class="tag priority-<%= t.prioridad %>"><%= t.prioridad %></span></td>
            <td style="color:var(--fg-muted);font-size:12px">
              <%= t.fecha_limite ? new Date(t.fecha_limite).toLocaleDateString('es-ES') : '—' %>
            </td>
            <td style="text-align:right">
              <a href="/tareas/edit/<%= t.id %>" class="btn btn--quiet btn--sm">Editar</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

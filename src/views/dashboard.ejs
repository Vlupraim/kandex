<div class="page-header">
  <div>
    <h1 class="page-title">Bienvenido, <%= user.nombre_usuario %></h1>
    <p class="page-subtitle">Resumen de tu actividad en Kandex</p>
  </div>
  <a href="/tareas/create" class="btn-primary-action">
    <i class="bi bi-plus-lg"></i> Nueva Tarea
  </a>
</div>

<div class="stats-grid">
  <div class="stat-card stat-blue">
    <div class="stat-icon"><i class="bi bi-circle"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= tareas.filter(t => t.estado === 'Por realizar').length %></span>
      <span class="stat-label">Por realizar</span>
    </div>
  </div>
  <div class="stat-card stat-amber">
    <div class="stat-icon"><i class="bi bi-arrow-repeat"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= tareas.filter(t => t.estado === 'En progreso').length %></span>
      <span class="stat-label">En progreso</span>
    </div>
  </div>
  <div class="stat-card stat-purple">
    <div class="stat-icon"><i class="bi bi-eye"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= tareas.filter(t => t.estado === 'En revisión').length %></span>
      <span class="stat-label">En revisión</span>
    </div>
  </div>
  <div class="stat-card stat-green">
    <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= tareas.filter(t => t.estado === 'Realizado').length %></span>
      <span class="stat-label">Realizadas</span>
    </div>
  </div>
</div>

<div class="section-header">
  <h2 class="section-title"><i class="bi bi-kanban me-2"></i>Vista rápida del tablero</h2>
  <a href="/tareas" class="section-link">Ver tablero completo <i class="bi bi-arrow-right"></i></a>
</div>

<div class="kanban-grid">
  <% const estados = ['Por realizar','En progreso','En revisión','Realizado'];
     const iconos   = ['circle','arrow-repeat','eye','check-circle-fill'];
     estados.forEach((estado, i) => {
       const cols = tareas.filter(t => t.estado === estado).slice(0,3);
  %>
  <div class="kanban-col" data-estado="<%= estado %>">
    <div class="kanban-col-header">
      <span class="col-label col-<%= ['blue','amber','purple','green'][i] %>">
        <i class="bi bi-<%= iconos[i] %>"></i> <%= estado %>
      </span>
      <span class="col-count"><%= tareas.filter(t => t.estado === estado).length %></span>
    </div>
    <% cols.forEach(tarea => { %>
      <div class="task-card" draggable="true" data-id="<%= tarea.id %>">
        <p class="task-title"><%= tarea.titulo %></p>
        <p class="task-desc"><%= tarea.descripcion || '' %></p>
        <div class="task-footer">
          <span class="priority-badge priority-<%= tarea.prioridad %>"><%= tarea.prioridad %></span>
          <div class="task-actions">
            <a href="/tareas/edit/<%= tarea.id %>" class="task-btn"><i class="bi bi-pencil"></i></a>
            <a href="/tareas/delete/<%= tarea.id %>" class="task-btn task-btn-danger"><i class="bi bi-trash"></i></a>
          </div>
        </div>
      </div>
    <% }); %>
    <% if (cols.length === 0) { %>
      <div class="col-empty"><i class="bi bi-inbox"></i><span>Sin tareas</span></div>
    <% } %>
  </div>
  <% }); %>
</div>
